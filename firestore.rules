rules_version = '2';
service cloud.firestore {
  match / databases / { database } / documents {

    // 🟢 เพิ่มส่วนนี้: ระบบประกาศ Global (Announcements) สำหรับแอดมิน
    match / announcements / { document=**} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    //  ระบบ Online Status
    match / presences / { userId } {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // จองชื่อผู้เล่น
    match / usernames / { nameId } {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // โปรไฟล์ผู้เล่น (Users)
    match / users / { uid } {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == uid;
    }

    // ข้อมูลเกมของผู้เล่น (Players Store)
    match / players / { uid } {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Leaderboard: ทุกคนอ่านได้ แต่เขียนได้แค่ entry ของตัวเอง
    match / leaderboard / { uid } {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'username', 'stats', 'updatedAt']);
    }

    //  World Chat Rules
    match / chats / { messageId } {
      allow read: if true;
      allow create: if request.resource.data.uid != null;
      allow delete: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
    }

    // ตลาดกลาง (Marketplace Listings) - รองรับ Client Transaction
    match / listings / { listingId } {
      allow read: if request.auth != null;

      // อนุญาตให้สร้าง listing ได้เฉพาะตอนเป็นเจ้าของรายการ (sellerId ตรงกับ uid ตัวเอง)
      allow create: if request.auth != null
        && request.resource.data.sellerId == request.auth.uid;

      // อนุญาตให้อัปเดตสถานะได้ (เช่น ตอนกดซื้อ หรือยกเลิกการขาย)
      allow update: if request.auth != null;

      // ถ้าไม่อนุญาตให้ลบตรงๆ ให้ปล่อยเป็น false หรือเช็คสิทธิ์ตามต้องการ
      allow delete: if false;
    }

  }
}