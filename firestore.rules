rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    //  ระบบ Online Status
    match /presences/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }
  
    // จองชื่อผู้เล่น
    match /usernames/{nameId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // โปรไฟล์ผู้เล่น (Users)
    match /users/{uid} {
      allow read: if request.auth != null; // ปรับให้ปลอดภัยขึ้นเล็กน้อย หรือจะใช้ if true แบบเดิมก็ได้ครับ
      allow write: if request.auth.uid == uid;
    }

    // ข้อมูลเกมของผู้เล่น (Players Store)
     match /players/{uid} {
      //  โหมดทดสอบเท่านั้น: อนุญาตให้ผู้ใช้ที่ login แล้วแก้เอกสารของใครก็ได้
      // เพื่อให้ระบบซื้อขาย (โอนเงินให้ผู้ขาย) ทำงานได้จาก client โดยตรง
      // ต้องกลับไปจำกัดเป็น request.auth.uid == uid ก่อนขึ้น production จริง
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Leaderboard: ทุกคนอ่านได้ แต่เขียนได้แค่ entry ของตัวเอง
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(['uid', 'username', 'stats', 'updatedAt']);
    }

    //  World Chat Rules
    match /chats/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.uid != null;
      allow delete: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
    }

    // เพิ่มส่วนนี้: ตลาดกลาง (Marketplace Listings)
    // ทุกคน (ที่ login แล้ว) อ่านได้ แต่ห้ามเขียน/แก้ไขตรงเด็ดขาด ต้องผ่าน Cloud Function เท่านั้น
    // ตลาดกลาง (Marketplace Listings) - รองรับ Client Transaction
    match /listings/{listingId} {
      allow read: if request.auth != null;
      
      // อนุญาตให้สร้าง listing ได้เฉพาะตอนเป็นเจ้าของรายการ (sellerId ตรงกับ uid ตัวเอง)
      allow create: if request.auth != null 
                    && request.resource.data.sellerId == request.auth.uid;
      
      // อนุญาตให้อัปเดตสถานะได้ (เช่น ตอนกดซื้อ หรือยกเลิกการขาย)
      allow update: if request.auth != null;
      
      // ถ้าไม่อนุญาตให้ลบตรงๆ ให้ปล่อยเป็น false หรือเช็คสิทธิ์ตามต้องการ
      allow delete: if false;
    }

  }
}